rules_version = '2';
// 하이킥 팀 밸런서 — 운영진 PIN을 입력한 기기만 보고 수정할 수 있습니다.
// 실제 PIN은 이 저장소에 올리지 말고, Firebase 콘솔 > Firestore > 규칙에서만 'PIN_HERE'를 바꿔 게시하세요.
// PIN을 바꾸면 기존에 로그인한 기기는 자동으로 수정 권한이 사라집니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function pinOk(p) { return p == 'PIN_HERE'; }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && pinOk(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.pin);
    }

    // 기기별 운영진 표시 — 본인만 읽고, PIN이 맞을 때만 만들 수 있음
    match /admins/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                             && pinOk(request.resource.data.pin);
    }

    // 운영진 변경 기록 — 운영진만 보기·추가, 아무도 고치거나 지울 수 없음
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 회원·경기 기록·출석 등 — 운영진만 보기·수정
    match /{collection}/{docId} {
      allow read, write: if collection != 'admins' && collection != 'logs' && isAdmin();
    }
  }
}
